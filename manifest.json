{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Sherzod Norkulov",
  "homepage_url": "https://github.com/Sherzod-Norkulov",
  "permissions": [
    "tabs",
    "storage",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Rotator",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-rotation": {
      "description": "__MSG_commandToggleRotation__"
    },
    "stop-rotation": {
      "description": "__MSG_commandStopRotation__"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
